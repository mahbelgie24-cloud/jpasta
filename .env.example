# JPasta — environment variables (12-factor: secrets never enter the codebase)

# Canonical site URL (used by metadata, sitemap, e2e)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Build revision reported by /api/health (set by CI/deploy; public value).
NEXT_PUBLIC_COMMIT_SHA=dev

# WhatsApp ordering — the shop's number in international format, no +
NEXT_PUBLIC_WHATSAPP_NUMBER=970566064976

# Postgres (Neon) connection string for Drizzle.
# Workers use the HYPERDRIVE binding first; this is the Node/dev fallback.
# DATABASE_URL=

# Owner console — exactly 6 digits.
# JPASTA_OWNER_PIN=

# HMAC pepper for the O(1) PIN lookup. Must stay stable once production data
# exists (changing it invalidates every pin_lookup). Generate with:
#   openssl rand -hex 32
# AUTH_PEPPER=

# Signs 2-minute WebSocket tokens. Safe to rotate.
#   openssl rand -hex 32
# REALTIME_SECRET=

# AES-256-GCM key for customer PII at rest (64 hex chars / 32 bytes).
# REQUIRED for production deploys (scripts/check-env.mjs refuses without it).
#   openssl rand -hex 32
# PII_ENCRYPTION_KEY=

# Cron housekeeping secret (>=32 chars). Optional: without it the daily
# prune route returns 503 and the scheduled handler does nothing.
#   openssl rand -hex 32
# CRON_SECRET=

# Web Push (optional). Generate both with `npm run vapid`.
# The private key is a JWK JSON string — a secret, never commit it.
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_SUBJECT=https://jpasta.ps

# Cloudflare bindings (DO, R2, D1, Hyperdrive) live in wrangler.jsonc.
