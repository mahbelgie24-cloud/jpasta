{
  "name": "jpasta",
  "version": "0.1.0",
  "private": true,
  "description": "JPasta — Fresh Pasta & Chicken (Qalqilya) — digital menu, ordering & owner console",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "postinstall": "patch-package",
    "prebuild": "node scripts/ensure-opennext-stub.mjs",
    "build": "next build",
    "prebuild:cf": "node scripts/ensure-opennext-stub.mjs",
    "pretypecheck": "node scripts/ensure-opennext-stub.mjs",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/generate-icons.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "verify": "npm run format:check && npm run lint && npm run check:contrast && npm run typecheck && npm test && npm run build",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --tsconfig scripts/tsconfig.json db/seed.ts",
    "build:cf": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/check-env.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.28.0",
    "next": "~16.4.3",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "~16.4.3",
    "fake-indexeddb": "^6.2.6",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
