{
  "name": "jpasta",
  "version": "1.0.0",
  "private": true,
  "description": "JPasta — Fresh Pasta & Chicken (Qalqilya) — digital menu, ordering & owner console",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "postinstall": "patch-package",
    "prebuild": "node scripts/ensure-opennext-stub.mjs",
    "build": "next build",
    "prebuild:cf": "node scripts/ensure-opennext-stub.mjs",
    "pretypecheck": "node scripts/ensure-opennext-stub.mjs",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/generate-icons.mjs",
    "vapid": "node scripts/generate-vapid-keys.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "verify": "npm run format:check && npm run lint && npm run check:contrast && npm run typecheck && npm test && npm run build",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --tsconfig scripts/tsconfig.json db/seed.ts",
    "db:menu": "tsx --tsconfig scripts/tsconfig.json db/seed.ts --catalog",
    "db:backup": "node scripts/backup-db.mjs",
    "build:cf": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/check-env.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:update": "npm run build && playwright test --update-snapshots",
    "test:e2e:report": "playwright show-report",
    "test:lighthouse": "lhci autorun --config=./lighthouserc.json",
    "test:lighthouse:desktop": "lhci autorun --config=./lighthouserc.desktop.json"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.68.0",
    "next": "~16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.0",
    "@opennextjs/cloudflare": "^1.20.16",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "eslint-config-next": "~16.4.5",
    "fake-indexeddb": "^6.2.7",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
